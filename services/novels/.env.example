# Required
DATABASE_URL=postgresql://user:password@host:5432/railway
# Bearer token for POST /run (manual runs are disabled when unset)
NOVEL_SCRAPER_TOKEN=change-me

# Optional
# PROXY_URL=http://user:pass@proxy.example:8080
# PORT=8080
# SCHEDULER_ENABLED=true
# SCHEDULE_HOUR_UTC=4
# SCHEDULE_MINUTE_UTC=0
# RUN_INTERVAL_HOURS=24
# STARTUP_RUN_DELAY_SECONDS=120
# REQUEST_INTERVAL_MS=1000
# MAX_IN_FLIGHT=3
# NOVEL_CONCURRENCY=2
# CHAPTER_CONCURRENCY=2
# HTTP_TIMEOUT_MS=30000
# HTTP_MAX_RETRIES=3
# MAX_CHAPTERS_PER_NOVEL=500
# MAX_CHAPTERS_PER_RUN=0
# MISS_RETRY_BASE_HOURS=12
# MISS_RETRY_MAX_DAYS=30
# MIN_CONTENT_CHARS=30
# CIRCUIT_BREAKER_FAILURES=5
# LOG_LEVEL=info
